# Google OAuth — obtén tu Client ID en https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In — obtén tu Service ID en https://developer.apple.com
VITE_APPLE_CLIENT_ID=com.yourcompany.networking-ui
VITE_APPLE_REDIRECT_URI=https://yourdomain.com/auth/apple/callback
